<Robot type="FirstInspires-FTC">
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Expansion Hub 2" port="2">
            <goBILDA5202SeriesMotor name="IntakeMotor" port="0" />
            <goBILDA5202SeriesMotor name="TransferMotor" port="1" />
            <goBILDA5202SeriesMotor name="ShooterMotor1" port="2" />
            <goBILDA5202SeriesMotor name="ShooterMotor2" port="3" />
        </LynxModule>
        <LynxModule name="Control Hub" port="173">
            <goBILDAPinpoint name="pinpoint" port="0" bus="1" />
            <goBILDA5202SeriesMotor name="LFMotor" port="0" />
            <goBILDA5202SeriesMotor name="LBMotor" port="1" />
            <goBILDA5202SeriesMotor name="RFMotor" port="2" />
            <goBILDA5202SeriesMotor name="RBMotor" port="3" />
            <AnalogInput name="TurretServoEncoder1" port="0"/>
            <AnalogInput name="TurretServoEncoder1" port="0"/>
        </LynxModule>
        <ServoHub name="Servo Hub 3" port="3">
            <ContinuousRotationServo name="LTurretServo" port="0"/>
            <ContinuousRotationServo name="RTurretServo" port="1"/>
        </ServoHub>
    </LynxUsbDevice>
    <EthernetDevice serialNumber="EthernetOverUsb:eth0:172.29.0.23" name="Limelight" port="-1" ipAddress="172.29.0.1" />
</Robot>
